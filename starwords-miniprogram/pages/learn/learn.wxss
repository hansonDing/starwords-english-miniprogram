.page {
  padding: 24rpx 32rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部进度 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #e5e7eb;
}

.dot.done {
  background: #fbbf24;
}

.dot.current {
  background: #6d59eb;
  width: 36rpx;
  border-radius: 10rpx;
}

.step-label {
  font-size: 24rpx;
  color: #6b7280;
}

/* 卡片 */
.main-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
}

/* 卡片是 flex 居中列布局，按钮默认会收缩到文字宽度（文字贴边），
   这里统一撑满卡片宽度并留出左右内边距 */
.main-card .btn-primary,
.main-card .btn-ghost {
  width: 100%;
  box-sizing: border-box;
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.step-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #6d59eb;
  margin-bottom: 24rpx;
}

.word-img {
  width: 280rpx;
  height: 280rpx;
  border-radius: 32rpx;
  background: #fafafa;
  margin-bottom: 20rpx;
}

.word-en {
  font-size: 64rpx;
  font-weight: 900;
  color: #1f2937;
}

.word-phonetic {
  font-size: 26rpx;
  color: #9ca3af;
  margin: 8rpx 0 20rpx;
}

.speaker {
  background: #ede9fe;
  color: #6d59eb;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  padding: 16rpx 44rpx;
  margin-bottom: 24rpx;
}

.speaker.small {
  font-size: 26rpx;
  padding: 10rpx 32rpx;
  margin-bottom: 20rpx;
}

.meaning-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f9fafb;
  border-radius: 24rpx;
  padding: 20rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.word-meaning {
  font-size: 36rpx;
  font-weight: 800;
  color: #374151;
}

.word-phrase {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #6b7280;
}

.word-phrase-cn {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 例句行：整行可点，朗读例句 */
.phrase-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  box-sizing: border-box;
  background: #eef2ff;
  border-radius: 18rpx;
}

.phrase-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.phrase-row .word-phrase {
  margin-top: 0;
}

.phrase-speaker {
  margin-left: 16rpx;
  font-size: 34rpx;
}

/* Step 1 下一步 */
.next-step-btn {
  margin-top: 28rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
}

/* 跟读 */
.mic {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #ede9fe;
  margin: 16rpx 0 24rpx;
}

.mic.recording {
  background: #fee2e2;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.mic-icon {
  font-size: 64rpx;
}

.mic-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

/* 自动评分卡片 */
.score-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  background: #f5f3ff;
}

.score-card.score-great {
  background: #ecfdf3;
}

.score-card.score-low {
  background: #fff7ed;
}

.score-stars {
  font-size: 30rpx;
}

.score-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.score-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #6d59eb;
}

.score-msg {
  font-size: 24rpx;
  color: #6b7280;
  flex: 1;
  min-width: 0;
}

.speak-hint {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 24rpx;
  text-align: center;
}

.row-btns {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.row-btns > view {
  flex: 1;
}

/* 测验 */
.quiz-word-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.quiz-word {
  font-size: 56rpx;
  font-weight: 900;
  color: #1f2937;
}

.quiz-phonetic {
  font-size: 24rpx;
  color: #9ca3af;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 3rpx solid #e5e7eb;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  background: #fafafa;
}

.option.right {
  border-color: #22c55e;
  background: #f0fdf4;
}

.option.wrong {
  border-color: #ef4444;
  background: #fef2f2;
}

.option-word {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.option-meaning {
  font-size: 30rpx;
  color: #374151;
}

.quiz-feedback {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  width: 100%;
}

.feedback-text {
  font-size: 30rpx;
  font-weight: 700;
}

.feedback-text.good {
  color: #22c55e;
}

.feedback-text.bad {
  color: #ef4444;
}

/* 庆祝 */
.celebrate {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
  padding-bottom: 40rpx;
}

/* ---------- 奖励动画片 ---------- */
.skip-btn {
  align-self: flex-end;
  margin-right: 32rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(109, 89, 235, 0.12);
  color: #6d59eb;
  font-size: 24rpx;
}

/* 舞台：夜空渐变 + 裁切，彩带在舞台内飘落 */
.stage {
  position: relative;
  width: 100%;
  height: 460rpx;
  margin-top: 16rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #ede9fe 0%, #f5f3ff 60%, #fff7ed 100%);
}

.confetti-item {
  position: absolute;
  top: -60rpx;
  opacity: 0;
  animation-name: confetti-fall;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

@keyframes confetti-fall {
  0% {
    transform: translateY(0) rotate(0deg);
    opacity: 0;
  }
  12% {
    opacity: 1;
  }
  100% {
    transform: translateY(560rpx) rotate(320deg);
    opacity: 0;
  }
}

.mascot-wrap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 90rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 28rpx;
}

.mascot {
  font-size: 160rpx;
  line-height: 1;
  opacity: 0;
  transform: scale(0.2);
}

/* 第一幕：星星蹦出来 */
.mascot.pop {
  animation: mascot-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes mascot-pop {
  0% {
    opacity: 0;
    transform: scale(0.2) translateY(60rpx);
  }
  60% {
    opacity: 1;
    transform: scale(1.18) translateY(0);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* 第二幕：星星跳舞（无限循环） */
.mascot.dance {
  animation: mascot-dance 1.1s ease-in-out infinite;
}

@keyframes mascot-dance {
  0% {
    transform: translateY(0) rotate(-8deg) scale(1);
  }
  50% {
    transform: translateY(-26rpx) rotate(8deg) scale(1.06);
  }
  100% {
    transform: translateY(0) rotate(-8deg) scale(1);
  }
}

.mascot-friend {
  font-size: 72rpx;
  line-height: 1;
  opacity: 0;
  transform: scale(0.2);
}

.mascot-friend.pop {
  animation: mascot-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

.mascot-friend.f2.pop {
  animation-delay: 0.14s;
}

.mascot-friend.f3.pop {
  animation-delay: 0.28s;
}

.bubble {
  position: absolute;
  left: 50%;
  top: 46rpx;
  transform: translateX(-50%) scale(0.6);
  opacity: 0;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(109, 89, 235, 0.18);
  font-size: 28rpx;
  font-weight: 700;
  color: #6d59eb;
  white-space: nowrap;
}

.bubble.show {
  animation: bubble-show 0.5s ease-out 0.15s forwards;
}

@keyframes bubble-show {
  from {
    opacity: 0;
    transform: translateX(-50%) scale(0.6);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }
}

/* 第三幕：单词巡游 */
.parade {
  width: 100%;
  padding: 32rpx 32rpx 0;
  box-sizing: border-box;
}

.parade-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #6d59eb;
}

.parade-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(109, 89, 235, 0.1);
  opacity: 0;
  animation: parade-in 0.5s ease-out forwards;
}

@keyframes parade-in {
  from {
    opacity: 0;
    transform: translateX(-50rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.parade-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.parade-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.parade-word {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.parade-meaning {
  font-size: 24rpx;
  color: #9ca3af;
}

.parade-star {
  font-size: 30rpx;
}

.celebrate-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 900;
  color: #6d59eb;
}

.celebrate-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #6b7280;
}

.achv-list {
  margin-top: 40rpx;
  width: 100%;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.achv-head {
  font-size: 28rpx;
  font-weight: 700;
  color: #92400e;
}

.achv-item {
  display: flex;
  align-items: center;
  background: #fffbeb;
  border: 3rpx solid #fbbf24;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}

.achv-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.achv-info {
  display: flex;
  flex-direction: column;
}

.achv-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #92400e;
}

.achv-desc {
  font-size: 24rpx;
  color: #b45309;
}

.back-btn {
  margin-top: 60rpx;
  width: 80%;
}
