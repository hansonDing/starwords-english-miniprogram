.page {
  padding: 24rpx 32rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部进度 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #e5e7eb;
}

.dot.done {
  background: #fbbf24;
}

.dot.current {
  background: #6d59eb;
  width: 36rpx;
  border-radius: 10rpx;
}

.step-label {
  font-size: 24rpx;
  color: #6b7280;
}

/* 卡片 */
.main-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
}

/* 卡片是 flex 居中列布局，按钮默认会收缩到文字宽度（文字贴边），
   这里统一撑满卡片宽度并留出左右内边距 */
.main-card .btn-primary,
.main-card .btn-ghost {
  width: 100%;
  box-sizing: border-box;
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.step-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #6d59eb;
  margin-bottom: 24rpx;
}

.word-img {
  width: 280rpx;
  height: 280rpx;
  border-radius: 32rpx;
  background: #fafafa;
  margin-bottom: 20rpx;
}

.word-en {
  font-size: 64rpx;
  font-weight: 900;
  color: #1f2937;
}

.word-phonetic {
  font-size: 26rpx;
  color: #9ca3af;
  margin: 8rpx 0 20rpx;
}

.speaker {
  background: #ede9fe;
  color: #6d59eb;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  padding: 16rpx 44rpx;
  margin-bottom: 24rpx;
}

.speaker.small {
  font-size: 26rpx;
  padding: 10rpx 32rpx;
  margin-bottom: 20rpx;
}

.meaning-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f9fafb;
  border-radius: 24rpx;
  padding: 20rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.word-meaning {
  font-size: 36rpx;
  font-weight: 800;
  color: #374151;
}

.word-phrase {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #6b7280;
}

.word-phrase-cn {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 例句行：整行可点，朗读例句 */
.phrase-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  box-sizing: border-box;
  background: #eef2ff;
  border-radius: 18rpx;
}

.phrase-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.phrase-row .word-phrase {
  margin-top: 0;
}

.phrase-speaker {
  margin-left: 16rpx;
  font-size: 34rpx;
}

/* Step 1 下一步 */
.next-step-btn {
  margin-top: 28rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
}

/* 跟读 */
.mic {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #ede9fe;
  margin: 16rpx 0 24rpx;
}

.mic.recording {
  background: #fee2e2;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.mic-icon {
  font-size: 64rpx;
}

.mic-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

/* 自动评分卡片：只显示 3 颗星 + 一句鼓励（分数对小朋友没意义） */
.score-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 28rpx;
  border-radius: 20rpx;
  background: #f5f3ff;
}

.score-card.score-great {
  background: #ecfdf3;
}

.score-card.score-good {
  background: #eff6ff;
}

.score-card.score-low {
  background: #fff7ed;
}

/* 0 星：完全没听到声音 —— 用中性的灰，不要像 1 星那样"橙色提醒" */
.score-card.score-none {
  background: #f3f4f6;
}

/* 三颗星：亮起来的是金色，没拿到的留浅灰（让小朋友看到"还差一颗"） */
.stars-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.star {
  font-size: 56rpx;
  line-height: 1;
  color: #e5e7eb;
}

.star.on {
  color: #ffb300;
  animation: star-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

/* 依次点亮，像分数一点点蹦出来 */
.star-2.on {
  animation-delay: 0.14s;
}

.star-3.on {
  animation-delay: 0.28s;
}

@keyframes star-pop {
  0% {
    transform: scale(0.2);
    opacity: 0;
  }
  65% {
    transform: scale(1.3);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.score-msg {
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
}

.speak-hint {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 24rpx;
  text-align: center;
}

.row-btns {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.row-btns > view {
  flex: 1;
}

/* 测验 */
.quiz-word-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.quiz-word {
  font-size: 56rpx;
  font-weight: 900;
  color: #1f2937;
}

.quiz-phonetic {
  font-size: 24rpx;
  color: #9ca3af;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 3rpx solid #e5e7eb;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  background: #fafafa;
}

.option.right {
  border-color: #22c55e;
  background: #f0fdf4;
}

.option.wrong {
  border-color: #ef4444;
  background: #fef2f2;
}

.option-word {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.option-meaning {
  font-size: 30rpx;
  color: #374151;
}

.quiz-feedback {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  width: 100%;
}

.feedback-text {
  font-size: 30rpx;
  font-weight: 700;
}

.feedback-text.good {
  color: #22c55e;
}

.feedback-text.bad {
  color: #ef4444;
}

/* 结算页（静态，零动画）
   ⚠️ 类名必须叫 .done-page 而不能叫 .done —— 本文件里已有 .dot.done / .match-item.done，
   基础 .done 规则会以相同的优先级覆盖掉进度点与配对项（静默把界面搞坏）。 */
.done-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 48rpx;
  padding-bottom: 40rpx;
}

.done-emoji {
  font-size: 96rpx;
  line-height: 1;
}

/* 今天学会的单词：静态清单，不带入场动画 */
.done-words {
  width: 100%;
  padding: 32rpx 32rpx 0;
  box-sizing: border-box;
}

.done-words-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #6d59eb;
}

.done-word {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(109, 89, 235, 0.1);
}

.done-word-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.done-word-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.done-word-en {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.done-word-cn {
  font-size: 24rpx;
  color: #9ca3af;
}

.done-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 900;
  color: #6d59eb;
}

.done-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #6b7280;
}

/* 本次攒下的星星（纯 CSS，无新增资源） */
.done-stars {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
  padding: 14rpx 36rpx;
  border-radius: 44rpx;
  background: #fff8e6;
  border: 3rpx solid #fbd77a;
}

.done-stars-icon {
  font-size: 34rpx;
}

.done-stars-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #b45309;
}

.achv-list {
  margin-top: 40rpx;
  width: 100%;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.achv-head {
  font-size: 28rpx;
  font-weight: 700;
  color: #92400e;
}

.achv-item {
  display: flex;
  align-items: center;
  background: #fffbeb;
  border: 3rpx solid #fbbf24;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}

.achv-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.achv-info {
  display: flex;
  flex-direction: column;
}

.achv-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #92400e;
}

.achv-desc {
  font-size: 24rpx;
  color: #b45309;
}

.back-btn {
  margin-top: 60rpx;
  width: 80%;
}

/* ============ Step 4 · 配对闯关（纯 CSS，零新增资源） ============ */
.match-hint {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 28rpx;
  text-align: center;
}

/* 两列等宽；min-width:0 防止长单词把某一列顶宽 */
.match-board {
  display: flex;
  width: 100%;
  gap: 20rpx;
  box-sizing: border-box;
}

.match-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 5 行要在一屏内放得下，所以行高给得克制 */
.match-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 14rpx 12rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  background: #f5f3ff;
}

.match-text {
  font-size: 28rpx;
  line-height: 1.3;
  text-align: center;
  word-break: break-word;
}

.match-word .match-text {
  font-weight: 700;
  color: #4b3fd0;
}

.match-meaning .match-text {
  color: #374151;
}

/* 选中 */
.match-item.picked {
  background: #ede9fe;
  border-color: #6d59eb;
}

/* 配对成功：留在原地锁定变绿（结束时 5 组对应关系完整可见，本身就是一次复习） */
.match-item.done {
  background: #ecfdf3;
  border-color: #34d399;
}

.match-item.done .match-text {
  color: #047857;
}

/* 配错：抖动一下自动复位，零惩罚 */
.match-item.wrong {
  background: #fef2f2;
  border-color: #f87171;
  animation: match-shake 0.4s ease-in-out;
}

.match-item.wrong .match-text {
  color: #b91c1c;
}

@keyframes match-shake {
  0%,
  100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-10rpx);
  }
  40% {
    transform: translateX(10rpx);
  }
  60% {
    transform: translateX(-6rpx);
  }
  80% {
    transform: translateX(6rpx);
  }
}

.match-progress {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.match-done-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ecfdf3;
}

.match-done-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #047857;
}

.match-next-btn {
  width: 100%;
}
