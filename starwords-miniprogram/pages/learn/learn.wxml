<!-- ============ 学习中 ============ -->
<block wx:if="{{phase === 'learning'}}">
  <!-- 顶部：进度点 -->
  <view class="topbar">
    <view class="dots">
      <view
        class="dot {{index < wordIndex || item.learned ? 'done' : index === wordIndex ? 'current' : ''}}"
        wx:for="{{weekWordsView}}"
        wx:key="id"
      ></view>
    </view>
    <text class="step-label">第 {{step}}/{{maxStep}} 步</text>
  </view>

  <!-- Step 1 · 听一听 -->
  <view class="card main-card" wx:if="{{step === 1}}">
    <text class="step-title">👀 看一看，听一听</text>
    <view class="word-img sprite">
      <image
        class="sprite-img"
        src="../../assets/sprite.jpg"
        mode="scaleToFill"
        style="transform: translate({{word.imgTx}}%, {{word.imgTy}}%)"
        binderror="onImgError"
      />
    </view>
    <text class="word-en">{{word.word}}</text>
    <text class="word-phonetic">{{word.phonetic}}</text>
    <view class="speaker" bindtap="playWord">🔊 点我听发音</view>
    <view class="meaning-box">
      <text class="word-meaning">{{word.meaning}}</text>
      <view class="phrase-row" wx:if="{{word.phrase}}" bindtap="playPhrase">
        <view class="phrase-text">
          <text class="word-phrase">{{word.phrase}}</text>
          <text class="word-phrase-cn">{{word.phraseMeaning}}</text>
        </view>
        <text class="phrase-speaker">🔊</text>
      </view>
    </view>
    <view class="btn-primary next-step-btn" bindtap="onStep1Done"><text>听好了，下一步 →</text></view>
  </view>

  <!-- Step 2 · 读一读 -->
  <view class="card main-card" wx:if="{{step === 2}}">
    <text class="step-title">🎤 大声跟读</text>
    <text class="word-en">{{word.word}}</text>
    <view class="speaker small" bindtap="playWord">🔊 再听一遍</view>
    <view
      class="mic {{recording ? 'recording' : ''}}"
      bindtouchstart="onStartRecord"
      bindtouchend="onStopRecord"
    >
      <text class="mic-icon">{{recording ? '🔴' : '🎙️'}}</text>
      <text class="mic-text">{{recording ? '正在录音…松开结束' : '按住说话'}}</text>
    </view>
    <!-- 0 星（完全没听到声音）也要给反馈，所以判 autoLevel 而不是 autoStarCount > 0 -->
    <view class="score-card score-{{autoLevel}}" wx:if="{{recorded && autoLevel}}">
      <view class="stars-row">
        <text class="star star-1 {{autoStarCount >= 1 ? 'on' : ''}}">★</text>
        <text class="star star-2 {{autoStarCount >= 2 ? 'on' : ''}}">★</text>
        <text class="star star-3 {{autoStarCount >= 3 ? 'on' : ''}}">★</text>
      </view>
      <text class="score-msg">{{autoMsg}}</text>
    </view>
    <view class="btn-ghost" wx:if="{{recorded}}" bindtap="onPlayBack">
      <text>{{playingBack ? '🔈 播放中…' : '▶ 听听自己的声音'}}</text>
    </view>
    <text class="speak-hint">听完示例 → 按住麦克风跟读 → 播放对比</text>
    <view class="row-btns">
      <view class="btn-ghost" bindtap="onSpeakSkip"><text>再练练，先跳过</text></view>
      <view class="btn-primary" bindtap="onSpeakGood"><text>我读对了 😄</text></view>
    </view>
  </view>

  <!-- Step 3 · 小测验 -->
  <view class="card main-card" wx:if="{{step === 3 && quiz}}">
    <text class="step-title">{{quiz.type === 'listen-pick' ? '👂 听音选词' : '🔤 选出意思'}}</text>

    <block wx:if="{{quiz.type === 'listen-pick'}}">
      <view class="speaker" bindtap="playWord">🔊 播放发音</view>
      <view class="options">
        <view
          class="option {{pickedIdx === index ? (quizCorrect ? 'right' : 'wrong') : ''}}"
          wx:for="{{quiz.options}}"
          wx:key="id"
          data-idx="{{index}}"
          bindtap="onPickOption"
        >
          <text class="option-word">{{item.word}}</text>
          <text class="option-meaning">{{item.meaning}}</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="quiz-word-box">
        <text class="quiz-word">{{word.word}}</text>
        <text class="quiz-phonetic">{{word.phonetic}}</text>
      </view>
      <view class="options">
        <view
          class="option {{pickedIdx === index ? (quizCorrect ? 'right' : 'wrong') : ''}}"
          wx:for="{{quiz.options}}"
          wx:key="id"
          data-idx="{{index}}"
          bindtap="onPickOption"
        >
          <text class="option-meaning">{{item.meaning}}</text>
        </view>
      </view>
    </block>

    <view class="quiz-feedback" wx:if="{{quizAnswered}}">
      <text class="feedback-text {{quizCorrect ? 'good' : 'bad'}}">
        {{quizCorrect ? '答对啦！⭐' : '正确答案：' + quiz.options[quiz.answerIdx].meaning}}
      </text>
      <!-- 最后一个单词：下一步是整组配对闯关，按钮文案跟着变（maxStep 为 4 即最后一个词） -->
      <view class="btn-primary" bindtap="onNextWord">
        <text>{{maxStep === 4 ? '去配对 →' : '下一个 →'}}</text>
      </view>
    </view>
  </view>

  <!-- Step 4 · 配对闯关：5 个单词 ↔ 5 个含义（右列已打乱），只在最后一个单词之后出现一次 -->
  <view class="card main-card" wx:if="{{step === 4}}">
    <text class="step-title">🔗 把单词和意思连起来</text>
    <text class="match-hint">先点左边的单词，再点右边对应的意思</text>

    <view class="match-board">
      <view class="match-col">
        <view
          class="match-item match-word {{item.done ? 'done' : ''}} {{item.picked ? 'picked' : ''}} {{item.wrong ? 'wrong' : ''}}"
          wx:for="{{matchLeft}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickMatchLeft"
        >
          <text class="match-text">{{item.text}}</text>
        </view>
      </view>
      <view class="match-col">
        <view
          class="match-item match-meaning {{item.done ? 'done' : ''}} {{item.picked ? 'picked' : ''}} {{item.wrong ? 'wrong' : ''}}"
          wx:for="{{matchRight}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickMatchRight"
        >
          <text class="match-text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <text class="match-progress">已配对 {{matchSolved}}/{{matchTotal}}</text>

    <view class="match-done-bar" wx:if="{{matchAllDone}}">
      <text class="match-done-text">全部配对成功！</text>
      <view class="btn-primary match-next-btn" bindtap="onMatchFinish"><text>完成啦 ✓</text></view>
    </view>
  </view>
</block>

<!-- ============ 结算页（静态，零动画） ============ -->
<view class="done-page" wx:if="{{phase === 'done'}}">
  <text class="done-emoji">🎉</text>
  <!-- 没有当天词卡 = 进来时本年级就已经没新词可学了（整个年级学完 / 该年级还没上线） -->
  <text class="done-title">{{doneWords.length ? '太棒了！今天的单词全部学会！' : gradeNote}}</text>
  <text class="done-sub">{{doneWords.length ? (gradeNote || '明天会解锁新的 5 个单词哦') : '更多年级的单词正在路上'}}</text>

  <!-- 本次跟读攒下的星星（计入「我的」页的账户总数） -->
  <view class="done-stars" wx:if="{{earnedStars > 0}}">
    <text class="done-stars-icon">⭐</text>
    <text class="done-stars-text">本次攒下 {{earnedStars}} 颗星</text>
  </view>

  <!-- 今天学会的单词：静态清单 -->
  <view class="done-words" wx:if="{{doneWords.length > 0}}">
    <text class="done-words-title">今天学会的单词</text>
    <view class="done-word" wx:for="{{doneWords}}" wx:key="id">
      <view class="done-word-img sprite">
        <image
          class="sprite-img"
          src="../../assets/sprite.jpg"
          mode="scaleToFill"
          style="transform: translate({{item.imgTx}}%, {{item.imgTy}}%)"
        />
      </view>
      <view class="done-word-text">
        <text class="done-word-en">{{item.word}}</text>
        <text class="done-word-cn">{{item.meaning}}</text>
      </view>
    </view>
  </view>

  <view class="achv-list" wx:if="{{newAchievements.length > 0}}">
    <text class="achv-head">获得新成就</text>
    <view class="achv-item" wx:for="{{newAchievements}}" wx:key="id">
      <text class="achv-icon">{{item.icon}}</text>
      <view class="achv-info">
        <text class="achv-name">{{item.name}}</text>
        <text class="achv-desc">{{item.description}}</text>
      </view>
    </view>
  </view>

  <view class="btn-primary back-btn" bindtap="onBackHome"><text>回首页</text></view>
</view>
