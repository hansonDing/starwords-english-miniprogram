.page {
  padding: 24rpx 28rpx 60rpx;
}

.sum-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.sum-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2937;
}

.sum-sub {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.bar {
  width: 100%;
  height: 16rpx;
  background: #ede9fe;
  border-radius: 16rpx;
  overflow: hidden;
  margin-top: 16rpx;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(135deg, #6d59eb, #9b8af4);
  border-radius: 16rpx;
}

.grade-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 4rpx solid transparent;
  box-shadow: 0 6rpx 20rpx rgba(109, 89, 235, 0.08);
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
}

.grade-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grade-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.grade-status {
  font-size: 24rpx;
  color: #6b7280;
}

.grade-meta {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 12rpx;
}

.grade-card.active {
  border-color: #6d59eb;
  box-shadow: 0 10rpx 28rpx rgba(109, 89, 235, 0.22);
}

.grade-card.active .grade-status,
.grade-card.doing .grade-status {
  color: #6d59eb;
  font-weight: 700;
}

.grade-card.done .grade-status {
  color: #10b981;
  font-weight: 700;
}

.grade-card.done .bar-fill {
  background: linear-gradient(135deg, #10b981, #6ee7b7);
}

.grade-card.locked {
  opacity: 0.55;
}

.grade-card.locked .bar-fill {
  background: #d1d5db;
}

.foot-note {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 20rpx;
}
