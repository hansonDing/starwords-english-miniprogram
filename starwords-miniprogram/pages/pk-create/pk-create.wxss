.page {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  margin-bottom: 24rpx;
}

/* ---------- 顶部说明 ---------- */
.head-card {
  display: flex;
  flex-direction: column;
}

.head-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1f2937;
}

.head-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

/* ---------- 单词不够 ---------- */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
}

.empty-emoji {
  font-size: 90rpx;
}

.empty-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.empty-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
}

.empty-btn {
  margin-top: 36rpx;
  width: 100%;
}

/* ---------- 勾选列表 ---------- */
.pick-card {
  padding: 24rpx;
}

.pick-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 20rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.pick-count {
  font-size: 30rpx;
  font-weight: 700;
  color: #6d59eb;
}

.pick-actions {
  display: flex;
  flex-direction: row;
}

.pick-action {
  margin-left: 28rpx;
  font-size: 26rpx;
  color: #6b7280;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  border: 2rpx solid #e5e7eb;
}

/* 一行一个单词：勾选框 + 单词/音标 + 中文含义 */
.pick-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 8rpx;
  border-bottom: 2rpx solid #f9fafb;
}

.pick-item.on {
  background: #f5f3ff;
  border-radius: 20rpx;
}

.tick {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #d1d5db;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: center;
}

.pick-item.on .tick {
  background: #6d59eb;
  border-color: #6d59eb;
}

.pick-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.pick-word {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.pick-phonetic {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.pick-meaning {
  flex: 0 0 auto;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #6b7280;
}

/* ---------- 待分享 ---------- */
.ready-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx;
}

.ready-emoji {
  font-size: 96rpx;
}

.ready-title {
  margin-top: 20rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2937;
}

.ready-sub {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #6d59eb;
  font-weight: 700;
}

.ready-flow {
  margin-top: 36rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  background: #f9fafb;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}

.ready-step {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.9;
}

.ready-warn {
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #d97706;
  text-align: center;
}

/* 分享按钮：小程序 <button> 自带边框与默认色，必须全部覆盖 */
.share-btn {
  background: linear-gradient(135deg, #6d59eb, #9b8af4);
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 700;
  padding: 24rpx 0;
  text-align: center;
  border: none;
  line-height: 1.2;
  box-shadow: 0 8rpx 24rpx rgba(109, 89, 235, 0.35);
}

.share-btn::after {
  border: none;
}

.sub-btn {
  margin-top: 20rpx;
}

/* ---------- 失败 ---------- */
.fail-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx;
}

.fail-emoji {
  font-size: 90rpx;
}

.fail-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.fail-text {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.6;
}

/* ---------- 通用 ---------- */
.foot-hint {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
}
