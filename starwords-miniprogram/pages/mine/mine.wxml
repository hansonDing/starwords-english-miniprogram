<view class="page">
  <!-- 账号卡片 -->
  <view class="card account-card">
    <view class="avatar">{{loggedIn ? '👧' : '👶'}}</view>
    <view class="account-info">
      <block wx:if="{{loggedIn}}">
        <input class="nickname-input" value="{{nickname}}" maxlength="12" bindblur="onNicknameInput" placeholder="给孩子起个昵称" />
        <text class="user-id">已通过微信登录</text>
      </block>
      <block wx:else>
        <text class="account-title">游客模式</text>
        <text class="user-id">登录后可云同步学习进度并参与排行榜</text>
      </block>
    </view>
  </view>

  <!-- 我的形象：登录后引导选一次，之后随时来这里换 -->
  <view class="card avatar-entry" bindtap="onEditAvatar">
    <view class="avatar-clip entry-clip">
      <image
        class="avatar-img"
        src="../../assets/avatars.png"
        mode="scaleToFill"
        style="transform: translate({{avatar.tx}}%, {{avatar.ty}}%)"
      />
    </view>
    <view class="entry-info">
      <text class="entry-title">我的星星形象</text>
      <text class="entry-sub" wx:if="{{hasAvatar}}">现在是「{{avatar.name}}」，点这里换一个</text>
      <text class="entry-sub" wx:else>选一个属于你的星星形象吧</text>
    </view>
    <text class="entry-arrow">›</text>
  </view>

  <!-- 星星账户：跟读攒下的星星，将来可以参加活动 -->
  <view class="card star-card">
    <view class="star-card-left">
      <text class="star-card-icon">⭐</text>
      <view class="star-card-info">
        <text class="star-card-num">{{stars}}</text>
        <text class="star-card-label">我的星星</text>
      </view>
    </view>
    <text class="star-card-hint">攒下的星星，以后可以参加活动哦</text>
  </view>

  <!-- 发起 PK：用我学过的单词出题，分享给小伙伴（需要登录，出题者身份要写进挑战） -->
  <view class="card pk-entry" wx:if="{{loggedIn}}" bindtap="onCreatePk">
    <text class="pk-entry-emoji">⚔️</text>
    <view class="pk-entry-info">
      <text class="pk-entry-title">发起单词 PK</text>
      <text class="pk-entry-sub">用我学过的单词考考小伙伴</text>
    </view>
    <text class="pk-entry-arrow">›</text>
  </view>

  <!-- 云服务不可用提示（本地学习不受影响） -->
  <view class="card cloud-warn" wx:if="{{!cloudAvailable}}">
    <text class="cloud-warn-title">云服务暂不可用</text>
    <text class="cloud-warn-text">学习进度已保存在本机，不影响孩子正常学习。{{cloudError}}</text>
  </view>

  <view class="btn-primary" wx:if="{{!loggedIn}}" bindtap="onLogin"><text>微信一键登录</text></view>
  <view class="btn-ghost sync-btn" wx:if="{{loggedIn}}" bindtap="onManualSync">
    <text>{{syncing ? '同步中…' : '↻ 手动同步进度'}}</text>
  </view>
  <text class="sync-text" wx:if="{{syncText}}">{{syncText}}</text>

  <!-- 排行榜 -->
  <view class="card board-card">
    <view class="board-head">
      <text class="title">学习排行榜</text>
      <text class="my-rank" wx:if="{{myRank > 0}}">我的排名：第 {{myRank}} 名</text>
    </view>

    <view class="board-empty" wx:if="{{leaderboard.length === 0}}">
      <text class="subtitle">还没有小伙伴上榜，快来做第一名！</text>
    </view>

    <view class="board-list" wx:else>
      <view class="board-item {{item.isMe ? 'me' : ''}}" wx:for="{{leaderboard}}" wx:key="rank">
        <text class="rank {{item.rank <= 3 ? 'top' : ''}}">{{item.rank <= 3 ? ['🥇','🥈','🥉'][item.rank-1] : item.rank}}</text>
        <view class="board-info">
          <text class="board-name">{{item.name}}{{item.isMe ? '（我）' : ''}}</text>
          <text class="board-sub">第 {{item.week}} 天 · 连续 {{item.streak}} 天</text>
        </view>
        <text class="board-count">{{item.learned}} 词</text>
        <!-- 挑战按钮：只有别人的行才有（自己的行不给「挑战自己」） -->
        <view
          class="challenge-btn"
          wx:if="{{!item.isMe}}"
          data-uid="{{item.uid}}"
          data-name="{{item.name}}"
          catchtap="onChallenge"
        ><text>挑战</text></view>
      </view>
    </view>
  </view>

  <!-- 我发起的 PK：谁接受了挑战、答对几题 -->
  <view class="card pk-card" wx:if="{{pkList.length > 0}}">
    <view class="board-head">
      <text class="title">我发起的 PK</text>
    </view>
    <view class="pk-row" wx:for="{{pkList}}" wx:key="id">
      <view class="pk-row-info">
        <text class="pk-row-name">挑战 {{item.who}}</text>
        <text class="pk-row-sub">{{item.total}} 道题</text>
      </view>
      <text class="pk-row-state {{item.done ? 'done' : ''}}">{{item.text}}</text>
    </view>
  </view>

  <view class="logout" wx:if="{{loggedIn}}" bindtap="onLogout"><text>退出登录</text></view>
</view>
