.page {
  padding: 24rpx 32rpx 48rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat {
  width: calc((100% - 20rpx) / 2 - 2rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx;
}

.stat-num {
  font-size: 56rpx;
  font-weight: 900;
  color: #6d59eb;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.journey {
  margin-bottom: 24rpx;
}

.journey-bar {
  height: 20rpx;
  background: #ede9fe;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 20rpx 0 12rpx;
}

.journey-fill {
  height: 100%;
  background: linear-gradient(90deg, #6d59eb, #fbbf24);
  border-radius: 10rpx;
}

/* ---------- 年级分段进度 ---------- */
.grade-rows {
  margin-top: 28rpx;
}

.grade-row {
  margin-top: 20rpx;
}

.grade-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grade-row-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}

.grade-row-status {
  font-size: 24rpx;
  color: #6b7280;
}

.grade-row-bar {
  height: 12rpx;
  background: #ede9fe;
  border-radius: 8rpx;
  overflow: hidden;
  margin-top: 10rpx;
}

.grade-row-fill {
  height: 100%;
  background: linear-gradient(90deg, #6d59eb, #9b8af4);
  border-radius: 8rpx;
}

.grade-row.active .grade-row-name,
.grade-row.active .grade-row-status {
  color: #6d59eb;
}

.grade-row.done .grade-row-status {
  color: #10b981;
  font-weight: 700;
}

.grade-row.done .grade-row-fill {
  background: linear-gradient(90deg, #10b981, #6ee7b7);
}

.grade-row.locked {
  opacity: 0.55;
}

.grade-row.locked .grade-row-fill {
  background: #d1d5db;
}

.achv-card {
  margin-bottom: 32rpx;
}

.achv-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.achv {
  width: calc((100% - 40rpx) / 3 - 2rpx);
  box-sizing: border-box;
  background: #f9fafb;
  border-radius: 24rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  filter: grayscale(1);
  opacity: 0.5;
}

.achv.unlocked {
  background: #fffbeb;
  filter: none;
  opacity: 1;
}

.achv-icon {
  font-size: 44rpx;
}

.achv-name {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #374151;
}

.achv-desc {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #9ca3af;
  text-align: center;
}

.danger-zone {
  display: flex;
  justify-content: center;
}

.reset-btn {
  color: #ef4444;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border: 3rpx solid #fecaca;
  border-radius: 44rpx;
  background: #fef2f2;
}
