.page {
  padding: 24rpx 24rpx 48rpx;
}

.card {
  margin-bottom: 24rpx;
}

.intro-card {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.card-note {
  display: block;
  margin: 10rpx 0 20rpx;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.7;
}

.intro-card .card-note {
  margin-bottom: 0;
}

.step {
  display: block;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.9;
}

/* ---------- 7 天列表 ---------- */
.day-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f3f4f6;
}

.day-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.row-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.row-head {
  display: flex;
  align-items: center;
}

.row-day {
  font-size: 24rpx;
  font-weight: 700;
  color: #6d59eb;
}

.today-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: #6d59eb;
  border-radius: 16rpx;
  padding: 2rpx 12rpx;
}

.row-title {
  margin-top: 6rpx;
  font-size: 30rpx;
  color: #1f2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-meta.empty {
  color: #d1d5db;
}

.row-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.mini-btn {
  min-width: 108rpx;
  margin-left: 14rpx;
  padding: 14rpx 20rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #6d59eb, #9b8af4);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.mini-btn.danger {
  background: #ffffff;
  color: #ef4444;
  border: 3rpx solid #fecaca;
}

/* ---------- 忙碌遮罩 ---------- */
.busy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.busy-box {
  width: 480rpx;
  padding: 40rpx 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.busy-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  text-align: center;
}

.busy-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
  text-align: center;
}

/* ---------- 绑定家长账号 ---------- */
.passcode-input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 28rpx;
  margin-bottom: 20rpx;
  border-radius: 44rpx;
  background: #f5f3ff;
  border: 3rpx solid #e4dfff;
  font-size: 30rpx;
  color: #1f2937;
  text-align: center;
}

.card-note.tip {
  margin: 16rpx 0 0;
  font-size: 22rpx;
  color: #b6b3c7;
}

.card-note.warn {
  margin: 16rpx 0 0;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  font-size: 22rpx;
  color: #c2410c;
  line-height: 1.7;
}

/* 卡片里按钮撑满并留左右内边距（避免文字贴到圆角边） */
.card .btn-primary,
.card .btn-ghost {
  width: 100%;
  box-sizing: border-box;
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.btn-primary.disabled {
  opacity: 0.6;
}
