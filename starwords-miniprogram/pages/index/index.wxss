.page {
  padding: 24rpx 32rpx 48rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 32rpx;
}

.hero-stars {
  font-size: 32rpx;
  color: #fbbf24;
  letter-spacing: 12rpx;
}

.hero-title {
  font-size: 64rpx;
  font-weight: 900;
  color: #6d59eb;
  letter-spacing: 4rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.streak-card {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.streak-flame {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.streak-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.streak-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #f97316;
}

.streak-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f5f3ff;
  border-radius: 24rpx;
  padding: 12rpx 28rpx;
}

.streak-badge-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #6d59eb;
}

.streak-badge-label {
  font-size: 22rpx;
  color: #6b7280;
}

.week-card {
  margin-bottom: 32rpx;
}

.week-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.week-progress {
  font-size: 28rpx;
  color: #6d59eb;
  font-weight: 700;
}

.week-bar {
  height: 16rpx;
  background: #ede9fe;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.week-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6d59eb, #38bdf8);
  border-radius: 8rpx;
  transition: width 0.4s ease;
}

.word-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.word-chip {
  width: calc((100% - 60rpx) / 4 - 2rpx);
  background: #fafafa;
  border: 3rpx solid #e5e7eb;
  border-radius: 24rpx;
  padding: 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.word-chip.learned {
  background: #fefce8;
  border-color: #fbbf24;
}

.word-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.word-text {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #374151;
}

.word-star {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  font-size: 28rpx;
}

/* ---------- 每日动画入口 ---------- */
.daily-card {
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #ede9fe, #f7f5ff);
}

.daily-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.daily-label {
  font-size: 22rpx;
  color: #6d59eb;
  font-weight: 700;
}

.daily-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.daily-en {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9ca3af;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.daily-play {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-left: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6d59eb, #9b8af4);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(109, 89, 235, 0.35);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
