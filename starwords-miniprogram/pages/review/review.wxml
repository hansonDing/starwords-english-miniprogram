<view class="page">
  <!-- 模式切换 -->
  <view class="tabs">
    <view class="tab {{mode === 'quick' ? 'active' : ''}}" data-mode="quick" bindtap="onModeChange">到期复习</view>
    <view class="tab {{mode === 'spelling' ? 'active' : ''}}" data-mode="spelling" bindtap="onModeChange">拼写挑战</view>
    <view class="tab {{mode === 'records' ? 'active' : ''}}" data-mode="records" bindtap="onModeChange">学习记录</view>
  </view>

  <!-- ===== 到期复习 ===== -->
  <block wx:if="{{mode === 'quick'}}">
    <view class="card empty" wx:if="{{dueWords.length === 0}}">
      <text class="empty-icon">🌱</text>
      <text class="empty-text">今天没有待复习的单词</text>
      <text class="empty-sub">学完新词后，第二天会安排复习哦</text>
    </view>

    <block wx:if="{{dueWords.length > 0 && !reviewDone && quiz}}">
      <view class="progress-line">
        <text>{{quizIndex + 1}} / {{dueWords.length}}</text>
      </view>
      <view class="card main-card">
        <text class="step-title">{{quiz.type === 'listen-pick' ? '👂 听音选词' : '🔤 选出意思'}}</text>
        <view class="speaker" wx:if="{{quiz.type === 'listen-pick'}}" bindtap="onPlayQuizAudio">🔊 播放发音</view>
        <view class="quiz-word-box" wx:else>
          <text class="quiz-word">{{currentWord.word}}</text>
          <text class="quiz-phonetic">{{currentWord.phonetic}}</text>
        </view>
        <view class="options">
          <view
            class="option {{pickedIdx === index ? (quizCorrect ? 'right' : 'wrong') : ''}}"
            wx:for="{{quiz.options}}"
            wx:key="id"
            data-idx="{{index}}"
            bindtap="onPickOption"
          >
            <text class="option-word" wx:if="{{quiz.type === 'listen-pick'}}">{{item.word}}</text>
            <text class="option-meaning">{{item.meaning}}</text>
          </view>
        </view>
        <view class="quiz-feedback" wx:if="{{quizAnswered}}">
          <text class="feedback-text {{quizCorrect ? 'good' : 'bad'}}">
            {{quizCorrect ? '记住了！⭐' : '再想想：' + quiz.options[quiz.answerIdx].word + ' ' + quiz.options[quiz.answerIdx].meaning}}
          </text>
          <view class="btn-primary" bindtap="onNextReview"><text>下一个 →</text></view>
        </view>
      </view>
    </block>

    <view class="card empty" wx:if="{{reviewDone}}">
      <text class="empty-icon">🎉</text>
      <text class="empty-text">复习完成！答对 {{reviewedCount}}/{{totalReviewed}}</text>
      <text class="empty-sub">答对的单词会安排更远期的复习</text>
    </view>

    <!-- 错题本：本轮做错的单词 + 正确答案（全对时不渲染） -->
    <view class="card wrong-card" wx:if="{{reviewDone && wrongList.length > 0}}">
      <text class="wrong-head">📝 错题本（{{wrongList.length}}）</text>
      <text class="wrong-sub">这些词再记一记，明天还会见到它们</text>
      <view class="wrong-item" wx:for="{{wrongList}}" wx:key="id">
        <view class="wrong-img sprite">
          <image
            class="sprite-img"
            src="../../assets/sprite.jpg"
            mode="scaleToFill"
            style="transform: translate({{item.imgTx}}%, {{item.imgTy}}%)"
            binderror="onRecordImgError"
          />
        </view>
        <view class="wrong-info">
          <view class="wrong-word-row">
            <text class="wrong-word">{{item.word}}</text>
            <text class="wrong-phonetic">{{item.phonetic}}</text>
          </view>
          <text class="wrong-meaning">正确答案：{{item.meaning}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- ===== 拼写挑战 ===== -->
  <block wx:if="{{mode === 'spelling'}}">
    <view class="card empty" wx:if="{{spellDone && spellWords.length === 0}}">
      <text class="empty-icon">📚</text>
      <text class="empty-text">先去学习页学几个单词吧</text>
    </view>
    <view class="card empty" wx:if="{{spellDone && spellWords.length > 0}}">
      <text class="empty-icon">🎉</text>
      <text class="empty-text">拼写挑战完成！</text>
    </view>

    <block wx:if="{{!spellDone && spell}}">
      <view class="progress-line">
        <text>{{spellIndex + 1}} / {{spellWords.length}}</text>
      </view>
      <view class="card main-card">
        <text class="step-title">✍️ 拼出这个单词</text>
        <view class="spell-img sprite">
          <image
            class="sprite-img"
            src="../../assets/sprite.jpg"
            mode="scaleToFill"
            style="transform: translate({{spell.word.imgTx}}%, {{spell.word.imgTy}}%)"
            binderror="onSpellImgError"
          />
        </view>
        <view class="speaker small" bindtap="onPlaySpellAudio">🔊 听发音</view>
        <text class="spell-meaning">{{spell.word.meaning}}</text>

        <view class="slots">
          <view class="slot {{index < spell.filled.length ? 'filled' : ''}}" wx:for="{{spell.target}}" wx:key="index">
            <text wx:if="{{index < spell.filled.length}}">{{spell.filled[index].char}}</text>
          </view>
        </view>
        <view class="btn-ghost undo" bindtap="onUndoTap"><text>⌫ 删掉一个</text></view>

        <view class="tiles">
          <view
            class="tile {{item.used ? 'used' : ''}}"
            wx:for="{{spell.tiles}}"
            wx:key="idx"
            data-idx="{{index}}"
            bindtap="onTileTap"
          >
            <text>{{item.char}}</text>
          </view>
        </view>

        <view class="quiz-feedback" wx:if="{{spellFeedback}}">
          <text class="feedback-text {{spellCorrect ? 'good' : 'bad'}}">{{spellFeedback}}</text>
          <view class="btn-primary" bindtap="onNextSpell"><text>下一个 →</text></view>
        </view>
      </view>
    </block>
  </block>

  <!-- ===== 学习记录 ===== -->
  <block wx:if="{{mode === 'records'}}">
    <view class="card empty" wx:if="{{recordsTotal === 0}}">
      <text class="empty-icon">⭐</text>
      <text class="empty-text">还没有学习记录</text>
      <text class="empty-sub">去学习页学几个单词吧</text>
    </view>
    <block wx:else>
      <view class="records-head">
        <text class="records-title">已学 {{recordsTotal}} 个单词</text>
        <text class="records-sub">已显示 {{records.length}} 个</text>
      </view>
      <view class="records">
        <view class="card record-item" wx:for="{{records}}" wx:key="id">
          <view class="record-img sprite">
            <image
              class="sprite-img"
              src="../../assets/sprite.jpg"
              mode="scaleToFill"
              style="transform: translate({{item.imgTx}}%, {{item.imgTy}}%)"
              data-idx="{{index}}"
              binderror="onRecordImgError"
            />
          </view>
          <view class="record-info">
            <text class="record-word">{{item.word}}</text>
            <text class="record-meaning">{{item.meaning}}</text>
          </view>
          <view class="record-right">
            <text class="record-score">{{item.score}}分</text>
            <text class="record-date">{{item.date}}</text>
          </view>
        </view>
      </view>
      <view class="btn-ghost load-more" wx:if="{{recordsHasMore}}" bindtap="onLoadMoreRecords">
        <text>加载更多 ↓</text>
      </view>
      <text class="records-end" wx:else>已显示全部 {{recordsTotal}} 个单词</text>
    </block>
  </block>
</view>
