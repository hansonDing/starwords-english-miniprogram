.page {
  padding: 24rpx 32rpx 48rpx;
}

.tabs {
  display: flex;
  background: #ede9fe;
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 700;
}

.tab.active {
  background: #ffffff;
  color: #6d59eb;
  box-shadow: 0 4rpx 12rpx rgba(109, 89, 235, 0.15);
}

.progress-line {
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.main-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
}

.step-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #6d59eb;
  margin-bottom: 24rpx;
}

.speaker {
  background: #ede9fe;
  color: #6d59eb;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  padding: 16rpx 44rpx;
  margin-bottom: 24rpx;
}

.speaker.small {
  font-size: 26rpx;
  padding: 10rpx 32rpx;
  margin-bottom: 16rpx;
}

.quiz-word-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.quiz-word {
  font-size: 56rpx;
  font-weight: 900;
  color: #1f2937;
}

.quiz-phonetic {
  font-size: 24rpx;
  color: #9ca3af;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 3rpx solid #e5e7eb;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  background: #fafafa;
}

.option.right {
  border-color: #22c55e;
  background: #f0fdf4;
}

.option.wrong {
  border-color: #ef4444;
  background: #fef2f2;
}

.option-word {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.option-meaning {
  font-size: 30rpx;
  color: #374151;
}

.quiz-feedback {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  width: 100%;
}

.feedback-text {
  font-size: 30rpx;
  font-weight: 700;
}

.feedback-text.good {
  color: #22c55e;
}

.feedback-text.bad {
  color: #ef4444;
}

/* 拼写 */
.spell-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 28rpx;
  background: #fafafa;
  margin-bottom: 8rpx;
}

.spell-meaning {
  font-size: 40rpx;
  font-weight: 800;
  color: #374151;
  margin-bottom: 24rpx;
}

.slots {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.slot {
  width: 64rpx;
  height: 80rpx;
  border-bottom: 6rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
  color: #6d59eb;
  text-transform: uppercase;
}

.slot.filled {
  border-bottom-color: #6d59eb;
}

.undo {
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  margin-bottom: 24rpx;
}

.tiles {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.tile {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #ede9fe;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
  color: #6d59eb;
  text-transform: uppercase;
}

.tile.used {
  opacity: 0.25;
}

/* 记录 */
.records {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.record-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #fafafa;
  margin-right: 20rpx;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-word {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.record-meaning {
  font-size: 24rpx;
  color: #6b7280;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.record-score {
  font-size: 28rpx;
  font-weight: 700;
  color: #6d59eb;
}

.record-date {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 学习记录：总数 + 翻页 */
.records-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 6rpx;
}

.records-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #374151;
}

.records-sub {
  font-size: 24rpx;
  color: #9ca3af;
}

.load-more {
  margin-top: 24rpx;
}

.records-end {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 错题本（复习结束时展示） */
.wrong-card {
  margin-top: 24rpx;
}

.wrong-head {
  font-size: 32rpx;
  font-weight: 800;
  color: #ef4444;
}

.wrong-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.wrong-item {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #fff7f7;
}

.wrong-img {
  width: 92rpx;
  height: 92rpx;
  border-radius: 18rpx;
  background: #ffffff;
  margin-right: 20rpx;
}

.wrong-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.wrong-word-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.wrong-word {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.wrong-phonetic {
  font-size: 22rpx;
  color: #9ca3af;
}

.wrong-meaning {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #ef4444;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #374151;
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9ca3af;
}
