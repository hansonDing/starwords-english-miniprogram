/* 全局样式：儿童友好的圆角 + 明亮配色 */
page {
  background: #f5f3ff;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #1f2937;
  font-size: 30rpx;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(109, 89, 235, 0.1);
  padding: 32rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #6d59eb, #9b8af4);
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 700;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(109, 89, 235, 0.35);
}

.btn-primary.disabled {
  opacity: 0.5;
}

.btn-ghost {
  background: #ffffff;
  color: #6d59eb;
  border: 3rpx solid #6d59eb;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 700;
  padding: 24rpx 0;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1f2937;
}

.subtitle {
  font-size: 26rpx;
  color: #6b7280;
}

/* ---------- 单词精灵图（sprite sheet）----------
   200 张单词图合并成 assets/sprite.jpg，原因：预览用的内置编译器会把工程内
   所有文件计入 MAX_SOURCE_FILES = 500 的硬上限，200 个独立图片文件会直接超限、
   导致预览首页打不开。这里用「外层容器裁切 + 内层整图位移」实现取格子，
   纯静态布局，真机与模拟器表现一致。
   16 列 × 13 行 = 208 格 >= 200 词，格子 112×112，整图 1792×1456。
   改布局时必须同步 utils/words.js 的 SPRITE 常量。 */
.sprite {
  position: relative;
  overflow: hidden;
  display: block;
}

.sprite-img {
  display: block;
  width: 1600%; /* 16 列 * 100% */
  height: 1300%; /* 13 行 * 100% */
}

/* ---------- 星星形象精灵图（assets/avatars.png）----------
   8 个拟人卡通小人合成一张（4 列 × 2 行，第 0 行男孩、第 1 行女孩），
   同样是为了不顶到 500 文件上限。取图方式与单词图完全一致：
   外层裁切 + 内层整图位移，位移量由 utils/avatar.js 按 4/2 算出。
   改布局时必须同步 utils/avatar.js 的 SPRITE 与 gen-avatars.py。 */
.avatar-clip {
  position: relative;
  overflow: hidden;
  display: block;
}

.avatar-img {
  display: block;
  width: 400%; /* 4 列 * 100% */
  height: 200%; /* 2 行 * 100% */
}
